#: src/options.cpp:25
msgid "Usage: reflash [OPTIONS] [DEVICE/FILE]\n"
msgstr "사용법: reflash [OPTIONS] [DEVICE/FILE]\n"

#: src/options.cpp:26
msgid "Rewrite device/file data in place to refresh flash storage (\"massage\").\n"
msgstr "플래시 저장소를 새로 고치도록 장치/파일 데이터를 제자리에서 다시 씁니다(“마사지”).\n"

#: src/options.cpp:29
msgid "I/O block size (default: auto-detect)\n"
msgstr "I/O 블록 크기(기본: 자동 감지)\n"

#: src/options.cpp:31
msgid "SQLite management database\n"
msgstr "SQLite 관리 데이터베이스\n"

#: src/options.cpp:33
msgid "Verify against DB (no rewrite)\n"
msgstr "DB와 대조 검증(다시 쓰기 없음)\n"

#: src/options.cpp:35
msgid "Raw whole-device/file rewrite (default)\n"
msgstr "장치/파일 원시 전체 다시 쓰기(기본)\n"

#: src/options.cpp:37
msgid "Filesystem walk/rewrite (unmounted automatically)\n"
msgstr "파일 시스템 순회/다시 쓰기(자동 마운트 해제)\n"

#: src/options.cpp:39
msgid "Open wxWidgets UI (requires a display)\n"
msgstr "wxWidgets UI 열기(디스플레이 필요)\n"

#: src/options.cpp:41
msgid "More logging\n"
msgstr "로그 늘리기\n"

#: src/options.cpp:43
msgid "Less logging\n"
msgstr "로그 줄이기\n"

#: src/options.cpp:45
msgid "Show this help\n"
msgstr "이 도움말 표시\n"

#: src/options.cpp:47
msgid "Show version\n"
msgstr "버전 표시\n"

#: src/options.cpp:49
msgid "Headless by default (DEVICE/FILE required). Progress goes to stderr.\n"
msgstr "기본은 헤드리스(DEVICE/FILE 필수). 진행 상황은 stderr로 갑니다.\n"

#: src/options.cpp:50
msgid "With -g/--gui, DEVICE/FILE is optional; open a target from the File menu.\n"
msgstr "-g/--gui에서는 DEVICE/FILE이 선택 사항이며 File 메뉴에서 대상을 엽니다.\n"

#: src/options.cpp:51
#, c-format
msgid "Report bugs to: <%s>\n"
msgstr "버그 보고: <%s>\n"

#: src/options.cpp:55
#, c-format
msgid "reflash %s\n"
msgstr "reflash %s\n"

#: src/options.cpp:56
#, c-format
msgid "Copyright (C) %d %s\n"
msgstr "Copyright (C) %d %s\n"

#: src/options.cpp:57
msgid "License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr "라이선스 AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/options.cpp:58
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "이것은 자유 소프트웨어입니다. 변경하고 재배포할 수 있습니다.\n"

#: src/options.cpp:59
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "이 프로젝트는 AI 착취와 AI 패권에 반대합니다.\n"

#: src/options.cpp:87
#, c-format
msgid "reflash: invalid --block-size\n"
msgstr "reflash: 잘못된 --block-size\n"

#: src/options.cpp:130
#, c-format
msgid "reflash: missing DEVICE/FILE\n"
msgstr "reflash: DEVICE/FILE이 없음\n"

#: src/options.cpp:135
#, c-format
msgid "reflash: too many arguments\n"
msgstr "reflash: 인수가 너무 많음\n"
