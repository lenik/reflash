#: src/options.cpp:25
msgid "Usage: reflash [OPTIONS] [DEVICE/FILE]\n"
msgstr "Uso: reflash [OPTIONS] [DEVICE/FILE]\n"

#: src/options.cpp:26
msgid "Rewrite device/file data in place to refresh flash storage (\"massage\").\n"
msgstr "Riscrive i dati del dispositivo/file sul posto per rinfrescare lo storage flash («massaggio»).\n"

#: src/options.cpp:29
msgid "I/O block size (default: auto-detect)\n"
msgstr "Dimensione blocco I/O (predefinito: auto)\n"

#: src/options.cpp:31
msgid "SQLite management database\n"
msgstr "Database SQLite di gestione\n"

#: src/options.cpp:33
msgid "Verify against DB (no rewrite)\n"
msgstr "Verifica contro il DB (senza riscrittura)\n"

#: src/options.cpp:35
msgid "Raw whole-device/file rewrite (default)\n"
msgstr "Riscrittura grezza dispositivo/file (predefinito)\n"

#: src/options.cpp:37
msgid "Filesystem walk/rewrite (unmounted automatically)\n"
msgstr "Percorso/riscrittura del filesystem (smontaggio automatico)\n"

#: src/options.cpp:39
msgid "Open wxWidgets UI (requires a display)\n"
msgstr "Apri UI wxWidgets (richiede un display)\n"

#: src/options.cpp:41
msgid "More logging\n"
msgstr "Più registrazione\n"

#: src/options.cpp:43
msgid "Less logging\n"
msgstr "Meno registrazione\n"

#: src/options.cpp:45
msgid "Show this help\n"
msgstr "Mostra questo aiuto\n"

#: src/options.cpp:47
msgid "Show version\n"
msgstr "Mostra la versione\n"

#: src/options.cpp:49
msgid "Headless by default (DEVICE/FILE required). Progress goes to stderr.\n"
msgstr "Senza interfaccia di default (DEVICE/FILE obbligatorio). Il progresso va su stderr.\n"

#: src/options.cpp:50
msgid "With -g/--gui, DEVICE/FILE is optional; open a target from the File menu.\n"
msgstr "Con -g/--gui, DEVICE/FILE è opzionale; apri un bersaglio dal menu File.\n"

#: src/options.cpp:51
#, c-format
msgid "Report bugs to: <%s>\n"
msgstr "Segnalare i bug a: <%s>\n"

#: src/options.cpp:55
#, c-format
msgid "reflash %s\n"
msgstr "reflash %s\n"

#: src/options.cpp:56
#, c-format
msgid "Copyright (C) %d %s\n"
msgstr "Copyright (C) %d %s\n"

#: src/options.cpp:57
msgid "License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr "Licenza AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/options.cpp:58
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "Questo è software libero: siete liberi di modificarlo e ridistribuirlo.\n"

#: src/options.cpp:59
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "Questo progetto si oppone allo sfruttamento e all’egemonia dell’IA.\n"

#: src/options.cpp:87
#, c-format
msgid "reflash: invalid --block-size\n"
msgstr "reflash: --block-size non valido\n"

#: src/options.cpp:130
#, c-format
msgid "reflash: missing DEVICE/FILE\n"
msgstr "reflash: DEVICE/FILE mancante\n"

#: src/options.cpp:135
#, c-format
msgid "reflash: too many arguments\n"
msgstr "reflash: troppi argomenti\n"
