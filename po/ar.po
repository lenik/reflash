#: src/options.cpp:25
msgid "Usage: reflash [OPTIONS] [DEVICE/FILE]\n"
msgstr "الاستخدام: reflash [OPTIONS] [DEVICE/FILE]\n"

#: src/options.cpp:26
msgid "Rewrite device/file data in place to refresh flash storage (\"massage\").\n"
msgstr "أعد كتابة بيانات الجهاز/الملف في مكانها لتجديد التخزين الومضي (\"مساج\").\n"

#: src/options.cpp:29
msgid "I/O block size (default: auto-detect)\n"
msgstr "حجم كتلة الإدخال/الإخراج (الافتراضي: اكتشاف تلقائي)\n"

#: src/options.cpp:31
msgid "SQLite management database\n"
msgstr "قاعدة بيانات إدارة SQLite\n"

#: src/options.cpp:33
msgid "Verify against DB (no rewrite)\n"
msgstr "تحقق مقابل قاعدة البيانات (بدون إعادة كتابة)\n"

#: src/options.cpp:35
msgid "Raw whole-device/file rewrite (default)\n"
msgstr "إعادة كتابة خام للجهاز/الملف بالكامل (الافتراضي)\n"

#: src/options.cpp:37
msgid "Filesystem walk/rewrite (unmounted automatically)\n"
msgstr "تجول في نظام الملفات وإعادة الكتابة (يُفك الربط تلقائياً)\n"

#: src/options.cpp:39
msgid "Open wxWidgets UI (requires a display)\n"
msgstr "افتح واجهة wxWidgets (يتطلب شاشة)\n"

#: src/options.cpp:41
msgid "More logging\n"
msgstr "المزيد من السجلات\n"

#: src/options.cpp:43
msgid "Less logging\n"
msgstr "سجلات أقل\n"

#: src/options.cpp:45
msgid "Show this help\n"
msgstr "اعرض هذه المساعدة\n"

#: src/options.cpp:47
msgid "Show version\n"
msgstr "اعرض الإصدار\n"

#: src/options.cpp:49
msgid "Headless by default (DEVICE/FILE required). Progress goes to stderr.\n"
msgstr "بلا واجهة افتراضياً (DEVICE/FILE مطلوب). التقدم يذهب إلى stderr.\n"

#: src/options.cpp:50
msgid "With -g/--gui, DEVICE/FILE is optional; open a target from the File menu.\n"
msgstr "مع -g/--gui، DEVICE/FILE اختياري؛ افتح هدفاً من قائمة File.\n"

#: src/options.cpp:51
#, c-format
msgid "Report bugs to: <%s>\n"
msgstr "بلّغ عن العلل إلى: <%s>\n"

#: src/options.cpp:55
#, c-format
msgid "reflash %s\n"
msgstr "reflash %s\n"

#: src/options.cpp:56
#, c-format
msgid "Copyright (C) %d %s\n"
msgstr "حقوق النشر (C) %d %s\n"

#: src/options.cpp:57
msgid "License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr "الترخيص AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/options.cpp:58
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "هذا برمجيات حرة: لك حرية تغييره وإعادة توزيعه.\n"

#: src/options.cpp:59
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "يعارض هذا المشروع استغلال الذكاء الاصطناعي وهيمنته.\n"

#: src/options.cpp:87
#, c-format
msgid "reflash: invalid --block-size\n"
msgstr "reflash: --block-size غير صالح\n"

#: src/options.cpp:130
#, c-format
msgid "reflash: missing DEVICE/FILE\n"
msgstr "reflash: DEVICE/FILE مفقود\n"

#: src/options.cpp:135
#, c-format
msgid "reflash: too many arguments\n"
msgstr "reflash: عدد كبير جداً من الوسائط\n"
