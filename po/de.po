#: src/options.cpp:25
msgid "Usage: reflash [OPTIONS] [DEVICE/FILE]\n"
msgstr "Aufruf: reflash [OPTIONS] [DEVICE/FILE]\n"

#: src/options.cpp:26
msgid "Rewrite device/file data in place to refresh flash storage (\"massage\").\n"
msgstr "Gerät-/Dateidaten an Ort und Stelle neu schreiben, um Flash-Speicher aufzufrischen („Massage“).\n"

#: src/options.cpp:29
msgid "I/O block size (default: auto-detect)\n"
msgstr "E/A-Blockgröße (Standard: auto)\n"

#: src/options.cpp:31
msgid "SQLite management database\n"
msgstr "SQLite-Verwaltungsdatenbank\n"

#: src/options.cpp:33
msgid "Verify against DB (no rewrite)\n"
msgstr "Gegen DB prüfen (kein Umschreiben)\n"

#: src/options.cpp:35
msgid "Raw whole-device/file rewrite (default)\n"
msgstr "Rohes Umschreiben von Gerät/Datei (Standard)\n"

#: src/options.cpp:37
msgid "Filesystem walk/rewrite (unmounted automatically)\n"
msgstr "Dateisystem-Durchlauf/Umschreiben (wird automatisch abgehängt)\n"

#: src/options.cpp:39
msgid "Open wxWidgets UI (requires a display)\n"
msgstr "wxWidgets-Oberfläche öffnen (Display nötig)\n"

#: src/options.cpp:41
msgid "More logging\n"
msgstr "Mehr Protokollierung\n"

#: src/options.cpp:43
msgid "Less logging\n"
msgstr "Weniger Protokollierung\n"

#: src/options.cpp:45
msgid "Show this help\n"
msgstr "Diese Hilfe anzeigen\n"

#: src/options.cpp:47
msgid "Show version\n"
msgstr "Version anzeigen\n"

#: src/options.cpp:49
msgid "Headless by default (DEVICE/FILE required). Progress goes to stderr.\n"
msgstr "Standardmäßig ohne GUI (DEVICE/FILE erforderlich). Fortschritt geht nach stderr.\n"

#: src/options.cpp:50
msgid "With -g/--gui, DEVICE/FILE is optional; open a target from the File menu.\n"
msgstr "Mit -g/--gui ist DEVICE/FILE optional; Ziel über das Dateimenü öffnen.\n"

#: src/options.cpp:51
#, c-format
msgid "Report bugs to: <%s>\n"
msgstr "Fehler melden an: <%s>\n"

#: src/options.cpp:55
#, c-format
msgid "reflash %s\n"
msgstr "reflash %s\n"

#: src/options.cpp:56
#, c-format
msgid "Copyright (C) %d %s\n"
msgstr "Copyright (C) %d %s\n"

#: src/options.cpp:57
msgid "License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr "Lizenz AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/options.cpp:58
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "Dies ist freie Software: Sie dürfen sie ändern und weitergeben.\n"

#: src/options.cpp:59
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "Dieses Projekt lehnt KI-Ausbeutung und KI-Hegemonie ab.\n"

#: src/options.cpp:87
#, c-format
