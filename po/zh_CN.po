#: src/options.cpp:25
msgid "Usage: reflash [OPTIONS] [DEVICE/FILE]\n"
msgstr "用法: reflash [OPTIONS] [DEVICE/FILE]\n"

#: src/options.cpp:26
msgid "Rewrite device/file data in place to refresh flash storage (\"massage\").\n"
msgstr "原地重写设备/文件数据，以刷新闪存（“马杀鸡”）。\n"

#: src/options.cpp:29
msgid "I/O block size (default: auto-detect)\n"
msgstr "I/O 块大小（默认：自动探测）\n"

#: src/options.cpp:31
msgid "SQLite management database\n"
msgstr "SQLite 管理数据库\n"

#: src/options.cpp:33
msgid "Verify against DB (no rewrite)\n"
msgstr "对照数据库校验（不重写）\n"

#: src/options.cpp:35
msgid "Raw whole-device/file rewrite (default)\n"
msgstr "整盘/整文件裸重写（默认）\n"

#: src/options.cpp:37
msgid "Filesystem walk/rewrite (unmounted automatically)\n"
msgstr "文件系统遍历/重写（自动卸载）\n"

#: src/options.cpp:39
msgid "Open wxWidgets UI (requires a display)\n"
msgstr "打开 wxWidgets 界面（需要显示器）\n"

#: src/options.cpp:41
msgid "More logging\n"
msgstr "增加日志\n"

#: src/options.cpp:43
msgid "Less logging\n"
msgstr "减少日志\n"

#: src/options.cpp:45
msgid "Show this help\n"
msgstr "显示此帮助\n"

#: src/options.cpp:47
msgid "Show version\n"
msgstr "显示版本\n"

#: src/options.cpp:49
msgid "Headless by default (DEVICE/FILE required). Progress goes to stderr.\n"
msgstr "默认无界面（必须提供 DEVICE/FILE）。进度输出到 stderr。\n"

#: src/options.cpp:50
msgid "With -g/--gui, DEVICE/FILE is optional; open a target from the File menu.\n"
msgstr "使用 -g/--gui 时 DEVICE/FILE 可选；从“文件”菜单打开目标。\n"

#: src/options.cpp:51
#, c-format
msgid "Report bugs to: <%s>\n"
msgstr "报告缺陷至：<%s>\n"

#: src/options.cpp:55
#, c-format
msgid "reflash %s\n"
msgstr "reflash %s\n"

#: src/options.cpp:56
#, c-format
msgid "Copyright (C) %d %s\n"
msgstr "Copyright (C) %d %s\n"

#: src/options.cpp:57
msgid "License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr "许可证 AGPL-3.0-or-later：<https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/options.cpp:58
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "这是自由软件：您可以自由修改和再分发。\n"

#: src/options.cpp:59
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "本项目反对 AI 剥削与 AI 霸权。\n"

#: src/options.cpp:87
#, c-format
msgid "reflash: invalid --block-size\n"
msgstr "reflash: 无效的 --block-size\n"

#: src/options.cpp:130
#, c-format
msgid "reflash: missing DEVICE/FILE\n"
msgstr "reflash: 缺少 DEVICE/FILE\n"

#: src/options.cpp:135
#, c-format
msgid "reflash: too many arguments\n"
msgstr "reflash: 参数过多\n"
