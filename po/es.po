#: src/options.cpp:25
msgid "Usage: reflash [OPTIONS] [DEVICE/FILE]\n"
msgstr "Uso: reflash [OPTIONS] [DEVICE/FILE]\n"

#: src/options.cpp:26
msgid "Rewrite device/file data in place to refresh flash storage (\"massage\").\n"
msgstr "Reescribe datos de dispositivo/archivo en el mismo lugar para refrescar el almacenamiento flash («masaje»).\n"

#: src/options.cpp:29
msgid "I/O block size (default: auto-detect)\n"
msgstr "Tamaño de bloque E/S (predeterminado: auto)\n"

#: src/options.cpp:31
msgid "SQLite management database\n"
msgstr "Base de datos SQLite de gestión\n"

#: src/options.cpp:33
msgid "Verify against DB (no rewrite)\n"
msgstr "Verificar contra la BD (sin reescribir)\n"

#: src/options.cpp:35
msgid "Raw whole-device/file rewrite (default)\n"
msgstr "Reescritura cruda de dispositivo/archivo (predeterminado)\n"

#: src/options.cpp:37
msgid "Filesystem walk/rewrite (unmounted automatically)\n"
msgstr "Recorrido/reescritura del sistema de archivos (se desmonta automáticamente)\n"

#: src/options.cpp:39
msgid "Open wxWidgets UI (requires a display)\n"
msgstr "Abrir UI wxWidgets (requiere pantalla)\n"

#: src/options.cpp:41
msgid "More logging\n"
msgstr "Más registro\n"

#: src/options.cpp:43
msgid "Less logging\n"
msgstr "Menos registro\n"

#: src/options.cpp:45
msgid "Show this help\n"
msgstr "Mostrar esta ayuda\n"

#: src/options.cpp:47
msgid "Show version\n"
msgstr "Mostrar versión\n"

#: src/options.cpp:49
msgid "Headless by default (DEVICE/FILE required). Progress goes to stderr.\n"
msgstr "Sin interfaz por defecto (DEVICE/FILE obligatorio). El progreso va a stderr.\n"

#: src/options.cpp:50
msgid "With -g/--gui, DEVICE/FILE is optional; open a target from the File menu.\n"
msgstr "Con -g/--gui, DEVICE/FILE es opcional; abra un destino desde el menú Archivo.\n"

#: src/options.cpp:51
#, c-format
msgid "Report bugs to: <%s>\n"
msgstr "Informar de errores a: <%s>\n"

#: src/options.cpp:55
#, c-format
msgid "reflash %s\n"
msgstr "reflash %s\n"

#: src/options.cpp:56
#, c-format
msgid "Copyright (C) %d %s\n"
msgstr "Copyright (C) %d %s\n"

#: src/options.cpp:57
msgid "License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr "Licencia AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/options.cpp:58
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "Este es software libre: puede modificarlo y redistribuirlo.\n"

#: src/options.cpp:59
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "Este proyecto se opone a la explotación y la hegemonía de la IA.\n"

#: src/options.cpp:87
#, c-format
msgid "reflash: invalid --block-size\n"
msgstr "reflash: --block-size no válido\n"

#: src/options.cpp:130
#, c-format
msgid "reflash: missing DEVICE/FILE\n"
msgstr "reflash: falta DEVICE/FILE\n"

#: src/options.cpp:135
#, c-format
msgid "reflash: too many arguments\n"
msgstr "reflash: demasiados argumentos\n"
