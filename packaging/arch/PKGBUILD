# SPDX-License-Identifier: AGPL-3.0-or-later
# stub — align with debian/control and Meson install
pkgname=reflash
pkgver=0.0.0
pkgrel=1
pkgdesc="Refresh flash storage by rewriting device data in place"
arch=('x86_64' 'aarch64')
url="https://github.com/lenik/reflash"
license=('AGPL-3.0-or-later')
depends=('sqlite' 'openssl' 'wxwidgets-gtk3')
makedepends=('meson' 'ninja' 'asciidoctor' 'pkgconf')
source=()
sha256sums=()

pkgver() {
  cd "$startdir/../.."
  zfr version 2>/dev/null | sed 's/^v//' || head -n1 VERSION
}

build() {
  cd "$startdir/../.."
  meson setup build-arch --prefix=/usr --buildtype=plain
  meson compile -C build-arch
}

package() {
  cd "$startdir/../.."
  DESTDIR="$pkgdir" meson install -C build-arch
}
